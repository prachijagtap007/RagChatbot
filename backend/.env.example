# Azure OpenAI resource and deployment names (not base model names).
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=YOUR-AZURE-OPENAI-KEY
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=YOUR-CHAT-DEPLOYMENT
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=YOUR-EMBEDDING-DEPLOYMENT
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536

# Azure AI Search service and index.
AZURE_SEARCH_ENDPOINT=https://YOUR-SEARCH-SERVICE.search.windows.net
AZURE_SEARCH_API_KEY=YOUR-AZURE-SEARCH-ADMIN-KEY
AZURE_SEARCH_INDEX_NAME=rag-documents
AZURE_SEARCH_SEMANTIC_CONFIG=rag-semantic-config

# Replace this with the folder containing your source documents.
DOCUMENTS_PATH=./data/documents
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
RETRIEVAL_TOP_K=8
